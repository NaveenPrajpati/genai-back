# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- Runtime / auth ---
APP_ENV=development                  # set to "production" in prod (enforces JWT_SECRET)
JWT_SECRET=                          # REQUIRED in production: a long random secret
                                     # (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)

# --- LLM ---
OPENAI_API_KEY=sk-...

# --- Vector DB (RAG) ---
PINECONE_KEY=...

# --- Supabase (chats, messages, meal plans/slots, todos, memory) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=...

# --- MongoDB (users, roadmaps, digests, triggers, approvals) ---
DATABASE_URL=postgresql://...        # Postgres for the LangGraph checkpointer
MONGODB_URI=mongodb+srv://...

# --- Redis (semantic cache) ---
REDIS_URL=redis://localhost:6379

# --- Tools ---
TAVILY_API_KEY=...                   # web search + reading a job posting from a URL
                                     # (degrades gracefully if unset: paste-only)
JINA_API_KEY=...                     # reranker + Jina Reader (renders JS pages for URL ingest)
URL_JS_FALLBACK=jina                 # jina | off — render JS-built pages via Jina Reader
                                     # when a plain fetch finds < 500 chars of text
EDAMAM_APP_ID=...                    # meal-planner nutrition lookup
EDAMAM_APP_KEY=...

# --- Observability: LangSmith tracing (opt-in) ---
LANGSMITH_TRACING=false              # set true to send traces
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=aiengineer-agents

# --- Fine-tuning capture (opt-in, off by default) ---
LLM_CAPTURE=0
LLM_CAPTURE_PATH=captures/llm_calls.jsonl


# --- Job search (job helper) ---
# Leave everything unset and search still works on a keyless board (Remotive,
# remote tech only). Add a key to widen coverage — see AGENT_SYSTEM.md §13.
JOB_SEARCH_PROVIDER=auto             # auto | jsearch | adzuna | remotive | arbeitnow
RAPIDAPI_KEY=                        # enables jsearch: best coverage, full descriptions
ADZUNA_APP_ID=                       # enables adzuna: global incl. India
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# --- Resume storage (job helper) ---
# The user's uploaded resume is kept unmodified here. CREATE THIS BUCKET PRIVATE:
# a resume is PII, and reads go through short-lived signed URLs.
RESUME_BUCKET=resumes
RESUME_URL_TTL=3600

# --- MCP servers ---
# Both are mounted on this app, so the defaults point back at ourselves. Set
# either to move that skill to its own host. The trailing slash matters.
MEAL_MCP_URL=''                      # default http://127.0.0.1:8000/mcp/
JOB_MCP_URL=''                       # default http://127.0.0.1:8000/mcp/jobs/
MCP_AUTH_TOKEN=                      # bearer token for both mounts; unset = no check